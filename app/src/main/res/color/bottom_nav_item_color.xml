<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom Navigation Item Color State List
  ========================================
  Defines color states for bottom navigation items.
  - Selected: Primary color for active state
  - Unselected: On-surface-variant for inactive state
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/primary" android:state_checked="true" />
    <item android:color="@color/on_surface_variant" android:state_checked="false" />
</selector>
