<?xml version="1.0" encoding="utf-8"?>
<!--
  xKey Authentication Request Card Background
  High-emphasis gradient for authentication alerts.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:startColor="@color/secondary_container"
        android:centerColor="@color/secondary_95"
        android:endColor="@color/secondary_container"
        android:angle="135" />
    <stroke
        android:width="2dp"
        android:color="@color/secondary" />
</shape>
