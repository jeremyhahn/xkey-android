<?xml version="1.0" encoding="utf-8"?>
<!--
  xKey Premium Button Background
  Gradient pill button with sophisticated styling.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:startColor="@color/primary_30"
                android:endColor="@color/primary_40"
                android:angle="90" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:startColor="@color/primary"
                android:endColor="@color/primary_40"
                android:angle="90" />
        </shape>
    </item>
</selector>
