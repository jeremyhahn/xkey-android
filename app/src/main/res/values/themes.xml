<?xml version="1.0" encoding="utf-8"?>
<!--
  xKey Theme System
  =================
  Copyright (c) 2024 xKey. All rights reserved.

  Premium Material 3 themes designed for security-focused applications.

  Theme Variants:
  1. Theme.xKey           - Light theme (this file)
  2. Theme.xKey           - Dark theme (navy-charcoal, not pure black), defined
                            under the same name in res/values-night/themes.xml
                            and selected automatically by the resource system
  3. Theme.xKey.Transparent - Transparent overlay for biometric prompts;
                            parent="Theme.xKey", so it follows light/dark too

  Design Principles:
  - Deep Navy primary conveys institutional trust and authority
  - Warm Gold secondary signals premium quality and achievement
  - Rich Teal tertiary indicates security and verification states
  - Warm ivory surfaces provide refined legibility
  - Edge-to-edge design with proper system bar handling
-->
<resources>

    <!-- ================================================================== -->
    <!-- LIGHT THEME                                                        -->
    <!-- Deep Navy primary, Warm Gold secondary, Rich Teal tertiary.        -->
    <!-- Warm ivory surfaces with professional warm-neutral outlines.        -->
    <!-- ================================================================== -->
    <style name="Theme.xKey" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary: Deep Navy (#1A237E family) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorPrimaryInverse">@color/inverse_primary</item>

        <!-- Secondary: Warm Gold (#FFB300 family) -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary: Rich Teal (#00897B family) -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <!-- Surface and Background: Warm Ivory -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>

        <!-- Material 3 Surface Container Hierarchy -->
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>

        <!-- Surface Dim and Bright -->
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>

        <!-- Surface Tint for Material 3 Elevation Overlays -->

        <!-- Error: Deep Crimson -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Outline: Warm Neutrals -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Scrim for Modal Overlays -->
        <item name="scrimBackground">@color/scrim</item>

        <!-- Edge-to-Edge: Status and Navigation Bars -->
        <item name="android:statusBarColor">@color/primary_variant</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window Configuration -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Default Text Appearance -->
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.xKey.Button</item>
        <item name="materialCardViewStyle">@style/Widget.xKey.CardView</item>
        <item name="textInputStyle">@style/Widget.xKey.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.xKey.Chip</item>
        <item name="floatingActionButtonStyle">@style/Widget.xKey.FloatingActionButton</item>
        <item name="bottomNavigationStyle">@style/Widget.xKey.BottomNavigationView</item>
        <item name="snackbarStyle">@style/Widget.xKey.Snackbar</item>
    </style>

    <!-- ================================================================== -->
    <!-- DARK THEME                                                         -->
    <!-- Lives in res/values-night/themes.xml under the SAME name            -->
    <!-- (Theme.xKey), so the system selects it automatically in dark mode.  -->
    <!-- There is deliberately no separate Theme.xKey.Dark style: a          -->
    <!-- second name would have to be applied by hand and could drift.       -->
    <!-- ================================================================== -->

    <!-- ================================================================== -->
    <!-- TRANSPARENT THEME                                                  -->
    <!-- Used for biometric prompt overlay activities.                       -->
    <!-- Fully transparent window with dim background scrim.                -->
    <!-- Inherits the light theme for any visible Material components.      -->
    <!-- ================================================================== -->
    <style name="Theme.xKey.Transparent" parent="Theme.xKey">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ================================================================== -->
    <!-- COMPONENT STYLES                                                   -->
    <!-- Premium styling for Material 3 components.                         -->
    <!-- ================================================================== -->

    <!-- Primary Button Style -->
    <style name="Widget.xKey.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.xKey.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Text Button Style -->
    <style name="Widget.xKey.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Security Action Button (Teal) -->
    <style name="Widget.xKey.Button.Security" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Warning Button (Gold) -->
    <style name="Widget.xKey.Button.Warning" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Danger Button (Error) -->
    <style name="Widget.xKey.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Card View Style -->
    <style name="Widget.xKey.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Outlined Card Style -->
    <style name="Widget.xKey.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Security Card Style (Teal accent) -->
    <style name="Widget.xKey.CardView.Security" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeColor">@color/tertiary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Text Input Layout Style -->
    <style name="Widget.xKey.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <!-- Theme attribute, not @color/primary: this style is the app-wide
             textInputStyle, so a hardcoded light navy stroke was invisible
             (1.08:1) against the dark input box in night mode. -->
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <!-- Filled Text Input Style -->
    <style name="Widget.xKey.TextInputLayout.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHighest</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.xKey.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Security Chip (Verified State) -->
    <style name="Widget.xKey.Chip.Verified" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipBackgroundColor">@color/security_verified_container</item>
        <item name="android:textColor">@color/on_security_verified_container</item>
        <item name="chipIconTint">@color/security_verified</item>
    </style>

    <!-- Warning Chip -->
    <style name="Widget.xKey.Chip.Warning" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipBackgroundColor">@color/security_warning_container</item>
        <item name="android:textColor">@color/on_security_warning_container</item>
        <item name="chipIconTint">@color/security_warning</item>
    </style>

    <!-- Danger Chip -->
    <style name="Widget.xKey.Chip.Danger" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipBackgroundColor">@color/security_danger_container</item>
        <item name="android:textColor">@color/on_security_danger_container</item>
        <item name="chipIconTint">@color/security_danger</item>
    </style>

    <!-- Floating Action Button Style -->
    <style name="Widget.xKey.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.xKey.FAB</item>
    </style>

    <!-- Secondary FAB (Gold) -->
    <style name="Widget.xKey.FloatingActionButton.Secondary" parent="Widget.Material3.FloatingActionButton.Secondary">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="tint">?attr/colorOnSecondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.xKey.FAB</item>
    </style>

    <!-- Security FAB (Teal) -->
    <style name="Widget.xKey.FloatingActionButton.Security" parent="Widget.Material3.FloatingActionButton.Tertiary">
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="tint">?attr/colorOnTertiary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.xKey.FAB</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.xKey.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Snackbar Style -->
    <style name="Widget.xKey.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceInverse</item>
        <item name="actionTextColorAlpha">1.0</item>
    </style>

    <!-- ================================================================== -->
    <!-- SHAPE APPEARANCES                                                  -->
    <!-- Premium corner treatments for Material components.                 -->
    <!-- ================================================================== -->

    <style name="ShapeAppearance.xKey.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.xKey.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.xKey.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.xKey.FAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ================================================================== -->
    <!-- TEXT APPEARANCES                                                   -->
    <!-- Typography styles for premium design.                              -->
    <!-- ================================================================== -->

    <style name="TextAppearance.xKey.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.xKey.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="TextAppearance.xKey.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.xKey.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.xKey.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Security Status Text -->
    <style name="TextAppearance.xKey.SecurityStatus" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.xKey.SecurityStatus.Verified">
        <item name="android:textColor">@color/security_verified</item>
    </style>

    <style name="TextAppearance.xKey.SecurityStatus.Warning">
        <item name="android:textColor">@color/security_warning</item>
    </style>

    <style name="TextAppearance.xKey.SecurityStatus.Danger">
        <item name="android:textColor">@color/security_danger</item>
    </style>

</resources>
