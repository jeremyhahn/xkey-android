<!--
    Credential Provider metadata for Android CredentialManager.

    This file declares the types of credentials this provider supports.
    Currently supports public-key credentials (passkeys) for WebAuthn/FIDO2.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declare support for public-key credentials (passkeys).
        This enables the app to:
        - Create new passkey credentials during registration
        - Return existing passkeys during authentication
    -->
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>

</credential-provider>
