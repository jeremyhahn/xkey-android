<!--
  Transparent layout for biometric prompt activity.
  This layout is intentionally empty as the only UI is the system biometric prompt.
  The activity uses a transparent theme, so this acts as an invisible container.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent" />
