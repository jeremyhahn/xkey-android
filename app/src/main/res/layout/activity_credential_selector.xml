<!--
    Layout for CredentialSelectorActivity.

    This is a minimal transparent layout that hosts the biometric prompt.
    The actual credential selection UI is provided by the Android system's
    CredentialManager UI.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".credential.ui.CredentialSelectorActivity">

    <!--
        Progress indicator shown while processing the credential request.
        Hidden by default; shown when biometric auth succeeds and we're
        generating/signing the credential.
    -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true" />

</FrameLayout>
