<!-- The detail of one desktop key: info, public key, sign test, attestation. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/desktopKeyDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desktop_keys_detail_info"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/textDesktopKeyInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true"
            tools:text="ID: k1" />

        <TextView
            android:id="@+id/textDesktopKeyPublicKeyHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Public key (der)" />

        <TextView
            android:id="@+id/textDesktopKeyPublicKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true"
            tools:text="MFkwEwYHKoZIzj0CAQ..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDesktopKeySignTest"
            style="@style/Widget.xKey.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/desktop_keys_sign_test" />

        <TextView
            android:id="@+id/textDesktopKeySignTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDesktopKeyAttest"
            style="@style/Widget.xKey.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/desktop_keys_attest" />

        <TextView
            android:id="@+id/textDesktopKeyAttestation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
