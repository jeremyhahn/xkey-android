<?xml version="1.0" encoding="utf-8"?>
<!--
  xKey Theme System - Dark (Night) Variant
  =======================================
  Copyright (c) 2024 xKey. All rights reserved.

  This file defines Theme.xKey under the -night resource qualifier. It uses the
  SAME style name as res/values/themes.xml on purpose: the resource system picks
  this definition automatically whenever the device is in dark mode, so no
  activity, manifest entry, or AppCompatDelegate call needs to name it.

  Because Theme.xKey.Transparent (res/values/themes.xml) declares
  parent="Theme.xKey", it resolves that parent against the current configuration
  and therefore inherits this dark theme in night mode as well.

  Colour strategy: this theme references the *_dark colour names directly.
  There is deliberately NO res/values-night/colors.xml redefining the base
  colour names. See the note at the bottom of this file for why.
-->
<resources>

    <!-- ================================================================== -->
    <!-- DARK THEME                                                         -->
    <!-- Navy-charcoal surfaces (not pure black) for premium depth.         -->
    <!-- Luminous color variants tuned for dark background legibility.      -->
    <!-- ================================================================== -->
    <style name="Theme.xKey" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Primary: Luminous Indigo -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant_dark</item>
        <item name="colorOnPrimary">@color/on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_dark</item>
        <item name="colorPrimaryInverse">@color/inverse_primary_dark</item>

        <!-- Secondary: Luminous Gold -->
        <item name="colorSecondary">@color/secondary_dark</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_dark</item>
        <item name="colorOnSecondary">@color/on_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container_dark</item>

        <!-- Tertiary: Luminous Teal -->
        <item name="colorTertiary">@color/tertiary_dark</item>
        <item name="colorOnTertiary">@color/on_tertiary_dark</item>
        <item name="colorTertiaryContainer">@color/tertiary_container_dark</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container_dark</item>

        <!-- Surface and Background: Deep Navy-Charcoal -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/on_background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <item name="colorSurfaceInverse">@color/inverse_surface_dark</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface_dark</item>

        <!-- Material 3 Surface Container Hierarchy -->
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest_dark</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low_dark</item>
        <item name="colorSurfaceContainer">@color/surface_container_dark</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high_dark</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest_dark</item>

        <!-- Surface Dim and Bright -->
        <item name="colorSurfaceDim">@color/surface_dim_dark</item>
        <item name="colorSurfaceBright">@color/surface_bright_dark</item>

        <!-- Error: Softened Crimson -->
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnError">@color/on_error_dark</item>
        <item name="colorErrorContainer">@color/error_container_dark</item>
        <item name="colorOnErrorContainer">@color/on_error_container_dark</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline_dark</item>
        <item name="colorOutlineVariant">@color/outline_variant_dark</item>

        <!-- Scrim for Modal Overlays -->
        <item name="scrimBackground">@color/scrim</item>

        <!-- Edge-to-Edge: Seamless dark bars -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window Configuration -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Default Text Appearance -->
        <item name="android:textColorPrimary">@color/on_background_dark</item>
        <item name="android:textColorSecondary">@color/on_surface_variant_dark</item>

        <!-- Component Styles (shared with the light theme; all resolve ?attr/*) -->
        <item name="materialButtonStyle">@style/Widget.xKey.Button</item>
        <item name="materialCardViewStyle">@style/Widget.xKey.CardView</item>
        <item name="textInputStyle">@style/Widget.xKey.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.xKey.Chip</item>
        <item name="floatingActionButtonStyle">@style/Widget.xKey.FloatingActionButton</item>
        <item name="bottomNavigationStyle">@style/Widget.xKey.BottomNavigationView</item>
        <item name="snackbarStyle">@style/Widget.xKey.Snackbar</item>
    </style>

    <!--
      WHY THERE IS NO res/values-night/colors.xml
      ==========================================
      Redefining the BASE colour names here (e.g. <color name="on_primary"> set
      to the dark value) would make every Kotlin ContextCompat.getColor(...) call
      site theme-aware for free. It was evaluated and rejected because the app
      does not use those names with Material 3 role semantics:

      "on_primary" is used in ~91 Kotlin call sites as the ink drawn on top of
      the navy BRAND GRADIENT (gradient_primary_start #1A237E -> _end #303F9F),
      not as the ink on colorPrimary. Aliasing it to on_primary_dark (#00006E)
      would put near-black text on that navy gradient at a 1.29:1 contrast ratio,
      destroying the toolbar title, navigation icon and hero labels on every
      gradient screen in the app.

      Only 64 of the 114 base colours have a designed *_dark counterpart, so a
      values-night override could not be complete either. The 50 without one are
      almost all tone-indexed ramp entries (primary_10..99, secondary_10..99,
      tertiary_10..99), scrims and brand gradients - all of which are correctly
      mode-independent by design.

      The correct place to fix the remaining light-mode leakage is the Kotlin
      call sites (resolve ?attr/colorOnSurface etc. via the theme), not a
      palette-level override.
    -->

</resources>
